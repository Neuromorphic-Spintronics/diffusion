\@writefile{toc}{\contentsline {title}{Conditional diffusion models as generative surrogates for reservoir computing substrates}{1}{chapter.1}\protected@file@percent }
\@writefile{toc}{\authcount {2}}
\@writefile{toc}{\contentsline {author}{Jack Griffiths, Rawana Yagan, Thomas J. Hayward \and Matthew O. A. Ellis}{1}{chapter.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces (top) The diffusion model transforms a known noise distribution into the trajectory distribution of each substrate. (bottom) Generated trajectories (purple, thin) from the held-out conditioning test set provide good agreement with the training data (black, thick) for (a)~the OU process, (b)~the Duffing oscillator, (c)~the DW oscillator, and (d)~experimental nanoring AMR signals.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:results}{{1}{2}{(top) The diffusion model transforms a known noise distribution into the trajectory distribution of each substrate. (bottom) Generated trajectories (purple, thin) from the held-out conditioning test set provide good agreement with the training data (black, thick) for (a)~the OU process, (b)~the Duffing oscillator, (c)~the DW oscillator, and (d)~experimental nanoring AMR signals}{figure.caption.2}{}}
